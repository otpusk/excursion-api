{
  "name": "@otpusk/excursion-api",
  "version": "0.0.66",
  "description": "",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./dist": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./dist/*": {
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    },
    "./package.json": "./package.json"
  },
  "browserslist": [
    "since 2021"
  ],
  "scripts": {
    "start": "BABEL_ENV=cjs babel-node src/playground.js",
    "transpile": "BABEL_ENV=cjs babel src --out-dir dist/cjs --ignore src/playground.js",
    "transpile:esm": "BABEL_ENV=esm babel src --out-dir dist/esm --ignore src/playground.js",
    "build": "npm run transpile && npm run transpile:esm",
    "publish-package": "npm publish"
  },
  "author": "Oleksandr Fishchenko",
  "license": "ISC",
  "devDependencies": {
    "@babel/cli": "^7.12.1",
    "@babel/core": "^7.12.3",
    "@babel/node": "^7.12.6",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.12.1",
    "babel-eslint": "^10.1.0",
    "eslint": "^6.8.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "fetch-jsonp": "^1.1.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
